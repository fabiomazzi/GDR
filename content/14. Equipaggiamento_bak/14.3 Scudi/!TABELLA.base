properties:
  file.name:
    displayName: Nome
views:
  - type: table
    name: Scudi
    filters:
      and:
        - Tipo == "scudo"
        - Magico != true
    order:
      - file.name
      - Bloccare
      - Parare
      - Malus DES
      - FF req
      - DES req
      - Capacità Speciali
      - Note
    sort:
      - property: Bloccare
        direction: ASC
    columnSize:
      note.Bloccare: 88
      note.Parare: 65
      note.Malus DES: 95
      note.FF req: 68
      note.DES req: 78
      note.Capacità Speciali: 515
